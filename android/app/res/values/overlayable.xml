<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <overlayable name="BluetoothConfig">
        <policy type="product|system|vendor">
            <!-- Params from config.xml that can be overlaid -->

            <!-- GATT connection priority values -->
            <item type="integer" name="gatt_high_priority_min_interval"/>
            <item type="integer" name="gatt_high_priority_max_interval"/>
            <item type="integer" name="gatt_high_priority_latency"/>
            <item type="integer" name="gatt_balanced_priority_min_interval"/>
            <item type="integer" name="gatt_balanced_priority_max_interval"/>
            <item type="integer" name="gatt_balanced_priority_latency"/>
            <item type="integer" name="gatt_low_power_min_interval"/>
            <item type="integer" name="gatt_low_power_max_interval"/>
            <item type="integer" name="gatt_low_power_latency"/>

            <!-- GATT connection priority values for primary companion -->
            <item type="integer" name="gatt_high_priority_min_interval_primary"/>
            <item type="integer" name="gatt_high_priority_max_interval_primary"/>
            <item type="integer" name="gatt_high_priority_latency_primary"/>
            <item type="integer" name="gatt_balanced_priority_min_interval_primary"/>
            <item type="integer" name="gatt_balanced_priority_max_interval_primary"/>
            <item type="integer" name="gatt_balanced_priority_latency_primary"/>
            <item type="integer" name="gatt_low_power_min_interval_primary"/>
            <item type="integer" name="gatt_low_power_max_interval_primary"/>
            <item type="integer" name="gatt_low_power_latency_primary"/>

            <!-- GATT connection priority values for secondary companion -->
            <item type="integer" name="gatt_high_priority_min_interval_secondary"/>
            <item type="integer" name="gatt_high_priority_max_interval_secondary"/>
            <item type="integer" name="gatt_high_priority_latency_secondary"/>
            <item type="integer" name="gatt_balanced_priority_min_interval_secondary"/>
            <item type="integer" name="gatt_balanced_priority_max_interval_secondary"/>
            <item type="integer" name="gatt_balanced_priority_latency_secondary"/>
            <item type="integer" name="gatt_low_power_min_interval_secondary"/>
            <item type="integer" name="gatt_low_power_max_interval_secondary"/>
            <item type="integer" name="gatt_low_power_latency_secondary"/>

            <!-- Batch scan throttler configuration -->
            <item type="integer" name="batch_scan_screen_off_minimum_delay_floor_ms"/>
            <item type="integer" name="batch_scan_unfiltered_delay_floor_ms"/>
            <item type="integer" name="batch_scan_unfiltered_screen_off_delay_floor_ms"/>
            <item type="integer" name="batch_scan_screen_off_delay_ms"/>

            <!-- A2DP sink values -->
            <item type="bool" name="a2dp_sink_automatically_request_audio_focus"/>

            <!-- AVRCP target values -->
            <item type="integer" name="config_safe_media_volume"/>

        </policy>
    </overlayable>
</resources>
