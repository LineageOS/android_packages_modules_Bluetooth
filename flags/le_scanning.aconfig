package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "support_passive_scanning"
    namespace: "bluetooth"
    is_exported: true
    description: "Support passive scannign by delivering adv packet w/o scan response"
    bug: "414501027"
}

flag {
    name: "upgrade_le_scan_only_screen_on"
    namespace: "bluetooth"
    description: "Allow to upgrade LE scan only when screen is on"
    bug: "438277701"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "stop_le_scan_system_suspend"
    namespace: "bluetooth"
    description: "Stop all LE scanners if the system is suspended"
    bug: "438826539"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
