package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "upgrade_le_scan_only_screen_on"
    namespace: "bluetooth"
    description: "Allow to upgrade LE scan only when screen is on"
    bug: "438277701"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "stop_le_scan_system_suspend"
    namespace: "bluetooth"
    description: "Stop all LE scanners if the system is suspended"
    bug: "438826539"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "stop_batch_scan_only_if_batch_client"
    namespace: "bluetooth"
    description: "Stop batch scan only if the client is a known batch scan client"
    bug: "446532441"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "scan_register_and_start"
    namespace: "bluetooth"
    description: "Merge the BluetoothLeScanner startRegistration and startScan"
    bug: "455057044"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "treat_empty_filters_as_unfiltered"
    namespace: "bluetooth"
    description: "Treat scans with all-fields-empty filters as unfiltered"
    bug: "461650493"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "support_native_pa_callback"
    namespace: "bluetooth"
    description: "Support native pa callback"
    bug: "462892602"
}

flag {
    name: "scan_allowance_throttling_enabled"
    namespace: "bluetooth"
    description: "The flag enables scan throttling using allowance."
    bug: "478996075"
}

