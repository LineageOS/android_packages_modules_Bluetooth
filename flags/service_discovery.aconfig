package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "service_discovery_on_connected_transport"
    namespace: "bluetooth"
    description: "Prefer to perform service discovery on all connected transport when transport is not specified"
    bug: "419542108"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "ignore_redundant_discovery_if_same_state"
    namespace: "bluetooth"
    description: "Ignore redundant service discovery enable or disable call if the state is the same"
    bug: "447313374"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "defer_br_edr_sdp_results"
    namespace: "bluetooth"
    description: "Delay the BR/EDR service discovery notification until after the LE discovery process"
    bug: "452481091"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "send_discovered_dev_to_new_pkgs"
    namespace: "bluetooth"
    description: "Send already discovered device to new packages starting discovery"
    bug: "450710779"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}


flag {
    name: "broadcast_uuids_from_main_looper"
    namespace: "bluetooth"
    description: "Broadcast service discovery results from main looper"
    bug: "462533972"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
