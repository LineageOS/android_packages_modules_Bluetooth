package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "enable_ble_while_disabling_airplane"
    namespace: "bluetooth"
    description: "Fix a race between enabling and handling airplane event"
    bug: "402563502"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "factory_reset_from_the_system_server"
    namespace: "bluetooth"
    description: "make possible to factoryReset the Bluetooth when it is off"
    bug: "406310419"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "kill_instead_of_exit"
    namespace: "bluetooth"
    description: "There is no value in pretending we are exiting properly. This is a kill and we should express it this way when finishing the process"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
    bug: "339553092"
}

flag {
    name: "publish_binder_on_start"
    namespace: "bluetooth"
    description: "As mentioned in SystemService.java, binder should be published during onStart"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
    bug: "407096751"
}

flag {
    name: "system_server_messenger"
    namespace: "bluetooth"
    description: "Replace binder call to the system server with a Messenger to enforce thread safety"
    bug: "321804999"
}

flag {
    name: "system_server_remove_extra_thread_jump"
    namespace: "bluetooth"
    description: "Methods are unnecessarily re-posting on the system server thread"
    bug: "402209603"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "wait_stack_role_before_starting"
    namespace: "bluetooth"
    description: "RoleManager is racing to give the SYSTEM_BLUETOOTH_STACK role prior to Bluetooth being started."
    bug: "408242259"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
