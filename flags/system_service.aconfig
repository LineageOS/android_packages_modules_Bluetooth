package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "kill_instead_of_exit"
    namespace: "bluetooth"
    description: "There is no value in pretending we are exiting properly. This is a kill and we should express it this way when finishing the process"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
    bug: "339553092"
}

flag {
    name: "limit_user_switch_propagation"
    namespace: "bluetooth"
    description: "Do not change the foreground user without restarting the stack"
    bug: "416313818"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "user_switch_during_ble_on"
    namespace: "bluetooth"
    description: "Clean user switch code to properly restart even during BLE_ON"
    bug: "419104737"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "graceful_disable_without_message"
    namespace: "bluetooth"
    description: "Handle disable requests gracefully without a delayed message"
    bug: "431067156"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "cleanup_starting_user"
    namespace: "bluetooth"
    description: "Allow the system server to initialize and start the stack when a foreground user start, without waiting on user switch"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
    bug: "418828239"
}

flag {
    name: "system_server_messenger"
    namespace: "bluetooth"
    description: "Replace binder call to the system server with a Messenger to enforce thread safety"
    bug: "321804999"
}

flag {
    name: "user_restriction_refactor"
    namespace: "bluetooth"
    description: "Move user restriction to Kotlin and properly check before any attempt to start Bluetooth"
    bug: "420992261"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "on_to_ble_on_via_off"
    namespace: "bluetooth"
    description: "When transitioning from ON to BLE_ON, go through OFF state completely to reset bluetooth state."
    bug: "431079894"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "watch_device_override_airplane_mode"
    namespace: "bluetooth"
    description: "If there is a watch connected, keep Bluetooth on"
    bug: "416092966"
}
