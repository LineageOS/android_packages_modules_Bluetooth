package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "mainline_beta_storage"
    namespace: "bluetooth"
    description: "Implement a robust storage to handle rollback"
    bug: "430166215"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "unify_timeout_property"
    namespace: "bluetooth"
    description: "Unify the various timeout in the stack to allow slower hardware to still boot"
    bug: "441576259"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "adapter_suspend_mgmt"
    namespace: "bluetooth"
    description: "Configure the BT adapter in a suspend state to avoid unexpected wake-up"
    bug: "366432079"
}

flag {
    name: "adapter_suspend_advertisement"
    namespace: "bluetooth"
    description: "Disable advertisement on adapter suspend and re-enable on resume"
    bug: "433136730"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "adapter_suspend_discoverability"
    namespace: "bluetooth"
    description: "Set discoverability to none on adapter suspend and restore on resume"
    bug: "435053102"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "ref_counted_native_wakelock"
    namespace: "bluetooth"
    description: "Make native wakelock reference counted"
    bug: "409059723"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "get_profile_oneway"
    namespace: "bluetooth"
    description: "do not block calling thread when fetching profiles"
    bug: "438829357"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "shutdown_main_thread_before_cleanup"
    namespace: "bluetooth"
    description: "Shutdown the legacy main thread before module cleanup"
    bug: "420748721"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "prioritized_in_ear_routing"
    namespace: "bluetooth"
    description: "Prioritized routing by checking in-ear state when multiple devices connected"
    bug: "420509925"
    is_exported: true
}

flag {
    name: "ignore_multiple_connect_request_in_bt_services"
    namespace: "bluetooth"
    description: "Ignore multiple connect request in BT Services"
    bug: "429143534"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "consistent_battery_level"
    namespace: "bluetooth"
    description: "Do not reset battey level from BAS to prevent battey level fluctuation"
    bug: "442696675"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
  name: "report_vendor_events_from_acl"
  namespace: "bluetooth"
  description: "Allows the Bluetooth stack to listen for and report vendor-specific events received over ACL connections. The valid handle range for these events is specified by the HCI Get Vendor Capabilities command."
  bug: "456742258"
  is_exported: true
}

