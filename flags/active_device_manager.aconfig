package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "adm_unset_others_on_hfp_changed"
    namespace: "bluetooth"
    description: "when HFP device is set as active, unset LE Audio and Hearing aid"
    bug: "419505580"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "adm_centralize_active_device_handling"
    namespace: "bluetooth"
    description: "ActiveDeviceManager is centralized manager of active Bluetooth device."
    bug: "429980017"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "adm_iterate_devices_on_fallback"
    namespace: "bluetooth"
    description: "Iterate over recently connected devices to find fallback"
    bug: "440528457"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
