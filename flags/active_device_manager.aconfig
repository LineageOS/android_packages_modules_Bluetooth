package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "adm_remove_handling_wired"
    namespace: "bluetooth"
    description: "ActiveDeviceManager doesn't need to handle adding and removing wired devices."
    bug: "390372480"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "adm_unset_others_on_hfp_changed"
    namespace: "bluetooth"
    description: "when HFP device is set as active, unset LE Audio and Hearing aid"
    bug: "419505580"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
