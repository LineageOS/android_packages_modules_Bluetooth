package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "a2dp_lhdc_api"
    namespace: "bluetooth"
    description: "API change for LHDC codec support"
    is_exported: true
    bug: "380118954"
}

flag {
    name: "a2dp_disconnect_reason_api"
    namespace: "bluetooth"
    description: "Define the extra parameter DISCONNECTED_REASON for a2dp.CONNECTION_STATE_CHANGED intent"
    bug: "416778270"
}

flag {
    name: "a2dp_sbc_underflow_recovery"
    namespace: "bluetooth"
    description: "Reset the SBC feeding counter to the limiting size"
    bug: "417543022"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "delay_sniff_subrating"
    namespace: "bluetooth"
    description: "Delay Sniff Subrating as in some remote's timing issues were observed"
    bug: "419205731"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_set_configuration_during_discovery"
    namespace: "bluetooth"
    description: "Accept AVDTP SetConfiguration during ongoing AVDTP Discovery"
    bug: "425738557"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "lhdc_codec_support"
    namespace: "bluetooth"
    description: "Implement support for the LHDCv5 codec"
    bug: "423977897"
}

flag {
    name: "a2dp_delay_report_in_dumpsys"
    namespace: "bluetooth"
    description: "Log AVDTP delay report events in dumpsys"
    bug: "426021684"
}

flag {
    name: "avdt_close_on_start_failure_bad_state"
    namespace: "bluetooth"
    description: "Close the AVDT connection on received BAD_STATE error on Start request"
    bug: "429135675"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "synchronize_codec_preferences_and_priority"
    namespace: "bluetooth"
    description: "Resolve incorrect codec priority of mandatory codec"
    bug: "438373657"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_source_null_fixed_queue"
    namespace: "bluetooth"
    description: "Resolve race in btif_a2dp_source between start and shutdown"
    bug: "432232478"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_adjust_sbc_bitpool"
    namespace: "bluetooth"
    description: "Correct invalid SBC bitpool values received from remote devices"
    bug: "441146545"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_reject_sho_request"
    namespace: "bluetooth"
    description: "Reject SHO request when rsp pending from active device"
    bug: "440286060"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_delay_disconnect"
    namespace: "bluetooth"
    description: "Delay A2DP profile disconnection to fix interoperability issues"
    bug: "440507683"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_cancel_acceptor_alarm_for_avdt_init"
    namespace: "bluetooth"
    description: "Cancel unnecessary timer for signalling as ACP"
    bug: "440264270"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_clear_pending_status_before_binder_call"
    namespace: "bluetooth"
    description: "Clear the a2dp AIDL pending cmd status before performing a binder call"
    bug: "448196961"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_control_codec_state_reports"
    namespace: "bluetooth"
    description: "Control codec state reports invocations from upper layers"
    bug: "452544619"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_source_metadata_changed"
    namespace: "bluetooth"
    description: "Optionally reconfigure the codec if the stream changes to gaming mode"
    bug: "448710897"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_ldac_api"
    namespace: "bluetooth"
    description: "API change for LDAC codec"
    is_exported: true
    bug: "445909312"
}

flag {
    name: "a2dp_create_codec_type_from_id_api"
    namespace: "bluetooth"
    description: "API change for BluetoothCodecType - create from codec ID"
    is_exported: true
    bug: "445930556"
}

flag {
    name: "a2dp_skip_discover_after_set_config"
    namespace: "bluetooth"
    description: "Skip AVDTP discover after set config to work around issues with older sinks."
    bug: "459426256"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "a2dp_sink_offload"
    namespace: "bluetooth"
    description: "API change for A2DP Sink Offload"
    bug: "460665704"
}
