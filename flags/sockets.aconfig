package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "invalidate_hci_handle_on_acl_removal"
    namespace: "bluetooth"
    description: "invalidate hci handle associated with lcb on acl removal"
    bug: "394329150"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "make_socket_read_behavior_consistent"
    namespace: "bluetooth"
    description: "Ensure both RFCOMM & LECOC sockets return value is consistent on EOF"
    bug: "408461997"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "flag_handle_hci_error_controller_busy"
    namespace: "bluetooth"
    description: "Handle HCI_ERR_CONTROLLER_BUSY error code in L2cap layer"
    bug: "413065608"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "downgrade_to_basic_mode_on_no_info_resp"
    namespace: "bluetooth"
    description: "Downgrade L2cap mode to basic on info response timeout"
    bug: "416031394"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "donot_pm_classic_on_le_traffic"
    namespace: "bluetooth"
    description: "Donot exit the sniff on classic link if on LE only traffic"
    bug: "416266693"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "fix_socket_connection_failed_no_callback"
    namespace: "bluetooth"
    description: "Fix Rfcomm Socket connection failed but callback not called"
    bug: "419814062"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "check_l2c_conn_status_before_param_validation"
    namespace: "bluetooth"
    description: "Check the L2CAP connection status before parameter validation"
    bug: "423056492"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "consider_l2c_header_bytes_for_mps_selection"
    namespace: "bluetooth"
    description: "while selecting the local MPS, consider the L2cap header bytes"
    bug: "427819296"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "lecoc_with_fixed_psm"
    namespace: "bluetooth"
    description: "Support LE CoC with fixed PSM"
    bug: "443347109"
}

flag {
    name: "pseudo_addr_in_socket_connect_signal"
    namespace: "bluetooth"
    description: "use pseudo address instead of identity address when sending socket signal"
    bug: "450667775"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "flush_socket_accept_signal"
    namespace: "bluetooth"
    description: "Flush the socket accept signal to miminmize the latency"
    bug: "461807788"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "add_address_mapping_for_lecoc"
    namespace: "bluetooth"
    description: "Derive the pseudo address from the identity address for LE CoC"
    bug: "465859619"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "fix_flow_control_logic_at_l2cap"
    namespace: "bluetooth"
    description: "Fix the flow control logic at l2cap layer"
    bug: "467155293"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
