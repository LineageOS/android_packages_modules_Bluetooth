package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "clear_pairing_state_when_no_devrec"
    namespace: "bluetooth"
    description: "Clear pairing state on early bond failure due to connection timeout and devrec is not created"
    bug: "364321751"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "trigger_sec_proc_on_inc_access_req"
    namespace: "bluetooth"
    description: "Trigger security procedure as acceptor as needed"
    bug: "376278485"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "ignore_auth_req_when_collision_timer_active"
    namespace: "bluetooth"
    description: "Ignore authentication request when collision timer is still active"
    bug: "380328715"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "donot_mandate_auth_along_with_encryption"
    namespace: "bluetooth"
    description: "Don't mandate authentication along with encryption"
    bug: "395476774"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "smp_connection_status_handling_when_no_acl"
    namespace: "bluetooth"
    description: "Fix SMP connection status sent from L2CAP when LE ACL is not connected"
    bug: "401073843"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "ignore_le_smp_conn_when_sm_over_br_progress"
    namespace: "bluetooth"
    description: "Ignore LE SMP connection when smp over br is still in progress"
    bug: "405996470"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "retain_address_type"
    namespace: "bluetooth"
    description: "Set correct address type in BluetoothDevice objects created by the Android Bluetooth"
    bug: "407277344"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "link_status_api"
    is_exported: true
    namespace: "bluetooth"
    description: "Add Link Status API to BluetoothDevice"
    bug: "419143231"
}

flag {
    name: "fix_ongoing_rnr_while_bonding"
    namespace: "bluetooth"
    description: "Fix pairing failure when RNR onging"
    bug: "430623282"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "concurrent_incoming_outgoing_pairing"
    namespace: "bluetooth"
    description: "Handle concurrent incoming and outgoing pairing requests"
    bug: "431870814"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "role_switch_after_encryption"
    namespace: "bluetooth"
    description: "Role switch after encryption if security procedure was initiated locally"
    bug: "431669341"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "skip_excess_name_discovery"
    namespace: "bluetooth"
    description: "Skip name discovery during BR/EDR pairing if the name is already known"
    bug: "434973460"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "conclude_le_pairing_immediately"
    namespace: "bluetooth"
    description: "Do add unnecessary delay to conclude LE pairing"
    bug: "436319185"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "pairing_collision_with_same_device"
    namespace: "bluetooth"
    description: "Continue pairing if collision is detected with the same device"
    bug: "438291410"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "reject_bond_request_during_bonding"
    namespace: "bluetooth"
    description: "Don't accept new bond request when bonding"
    bug: "439861848"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "modify_dev_rec_in_main_thread"
    namespace: "bluetooth"
    description: "Modify BTM device record list only in main thread"
    bug: "444243832"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "device_record_wipe_ranking"
    namespace: "bluetooth"
    description: "New ranking for wiping oldest device record"
    bug: "444268274"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "btm_le_pairing_state_reset"
    namespace: "bluetooth"
    description: "Reset BTM pairing state when LE pairing concludes"
    bug: "444741056"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "btm_iocaps_sysprop_override"
    namespace: "bluetooth"
    description: "Override IO capabilities using system properties"
    bug: "446939944"
}

flag {
    name: "apairing_26q2_permission_improvements"
    namespace: "bluetooth"
    description: "Permission improvements for pairing in 26Q2"
    bug: "449010608"
    is_exported: true
}

flag {
    name: "detect_bondloss_legacy_bredr_pairing"
    namespace: "bluetooth"
    description: "Detect bond loss during legacy BR/EDR pairing"
    bug: "455785260"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "provide_pairing_algo"
    namespace: "bluetooth"
    description: "Add pairing algorithm in pairing request"
    bug: "453979807"
    is_exported: true
}

flag {
    name: "autonomous_repairing_initiation"
    namespace: "bluetooth"
    description: "Initiate autonomous re-pairing when bond loss is detected."
    bug: "459695529"
    is_exported: true
}

flag {
    name: "btm_disconnect_on_remove"
    namespace: "bluetooth"
    description: "BTM must disconnect any connection when bond is removed"
    bug: "461581261"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "security_mode_3_pairing"
    namespace: "bluetooth"
    description: "Fixes pairing with devices which are in BR/EDR security mode 3."
    bug: "460502961"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "prevent_btm_sec_cb_overwrite_during_pairing"
    namespace: "bluetooth"
    description: "If the pairing state is not idle, do not overwrite btm_sec_cb"
    bug: "467193133"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "non_ctkd_dual_mode_pairing"
    namespace: "bluetooth"
    description: "Allow applications to initiate separate pairing for different transports with non-CTKD supporting dual mode devices"
    bug: "467761282"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "cancel_pairing_while_remove_bond"
    namespace: "bluetooth"
    description: "Cancel the ongoing pairing or SDP when remove bond is called."
    bug: "472917739"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}